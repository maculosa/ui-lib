{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.dts.tsbuildinfo"
  },
  /* 仅用于 vite-plugin-dts 生成声明文件：
     auto-imports.d.ts / components.d.ts 由 unplugin 在构建时生成，
     其中把 PropType、ExtractPropTypes 等提升为全局类型，会让 TS 输出
     globalThis.PropType 这类无法被使用方解析的引用，故在 dts 编译中排除 */
  "exclude": [
    "src/auto-imports.d.ts",
    "src/components.d.ts",
    "src/**/components.d.ts"
  ]
}
